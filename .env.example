# Neon pooled connection URL (TLS required in production).
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/raxlet?sslmode=require
# Exact canonical site URL; register it before launching from third-party pages.
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48. Never commit the generated secret.
BETTER_AUTH_SECRET=
# Comma-separated database user IDs; do not use names or client-editable roles.
ADMIN_USER_IDS=
# For destructive integration tests ONLY: a separate disposable PostgreSQL database.
TEST_DATABASE_URL=
