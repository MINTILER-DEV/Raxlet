{
  "name": "raxlet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-launcher.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "predev": "node scripts/build-launcher.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "build:packed": "node scripts/build-packed.mjs",
    "pretest": "npm run build:packed",
    "pretest:integration": "npm run build:packed"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "acorn": "^8.19.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "^7.7.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "terser": "^5.51.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.16"
  },
  "type": "module",
  "overrides": {
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2"
  }
}
